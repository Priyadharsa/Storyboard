# Create a key in the Meta Model API dashboard and paste it here.
# Never commit your real .env file to Git.
MODEL_API_KEY=LLM_2381810769291979_VlW-Ce3vDJrIOIW8V_PP__DoD4s

# Models currently used by FramePilot AI
MUSE_SPARK_MODEL=muse-spark-1.3
MUSE_IMAGE_MODEL=muse-image-1.0

# Meta Segment Anything Model 3.1
SAM_MODEL=sam-3.1

# Durable 1 GiB upload settings: LOCAL = Windows single-host mode.
FRAMEPILOT_UPLOAD_BACKEND=local
FRAMEPILOT_ACTIVE_UPLOAD_QUOTA_GIB=4
# For S3 multipart at scale, see docs/SCALING.md and requirements-s3.txt
# FRAMEPILOT_UPLOAD_BACKEND=s3
# FRAMEPILOT_S3_BUCKET=framepilot-private-assets
# FRAMEPILOT_S3_ENDPOINT=
# AWS_REGION=ap-south-1

# Profiles / server-side project ownership
# local: existing single-computer workflow; accounts: require registration/sign-in.
FRAMEPILOT_AUTH_MODE=local
# Enable only when served over HTTPS (reverse proxy must pass correct scheme).
# FRAMEPILOT_COOKIE_SECURE=1
# Max Meta Image calls per batch and local background workers
FRAMEPILOT_MAX_BATCH_SHOTS=32
FRAMEPILOT_MAX_BOOK_SHOTS=25000
FRAMEPILOT_GENERATION_WORKERS=2
FRAMEPILOT_MAX_PARALLEL_RENDERERS=8
# Aggregate model-call pacing, for one host only; does not bypass provider limits.
FRAMEPILOT_IMAGE_RPM=90

# Whole-film rendering is OFF until the user explicitly confirms model calls.

# v0.10.1 traffic/admission controls (per process, not a distributed quota)
FRAMEPILOT_MAX_INFLIGHT=128
# Disabled by default for local use; enable e.g. 240 in shared staging.
FRAMEPILOT_PER_IDENTITY_RPM=0
FRAMEPILOT_MIN_FREE_MB=256
# Set to 'distributed' to deliberately return unready until DB/queue migration done.
FRAMEPILOT_DEPLOYMENT_PROFILE=local
# Define a secret only on the server to read private metrics via X-Ops-Token.
# FRAMEPILOT_OPERATIONS_TOKEN=

# Optional and local-only: accepts trusted .blend uploads, opens Blender headlessly. Never enable on a public server.
FRAMEPILOT_ENABLE_LOCAL_BLEND=0
# FRAMEPILOT_BLENDER_BIN=C:\\Program Files\\Blender Foundation\\Blender 4.5\\blender.exe
